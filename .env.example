# Пример конфигурации. Скопируйте в .env и задайте свои значения.
# Реальные секреты в репозиторий/архив/образ НЕ коммитить (MOT-002).
# Если .env нет, docker-compose использует безопасные значения по умолчанию.

# --- БД (MariaDB 10.1) ---
DB_ROOT_PASSWORD=change-me-root
DB_USER=report
DB_PASSWORD=change-me-report

# --- Приложение ---
SECRET_KEY=change-me-long-random-string   # ключ подписи сессий Flask
ADMIN_LOGIN=admin                          # первый администратор (создаётся при старте)
ADMIN_PASSWORD=change-me-admin             # сменить после первого входа
APP_PORT=80
TZ=Asia/Yekaterinburg
COOKIE_SECURE=0                            # 1 — ставить флаг Secure на cookie (за HTTPS)
